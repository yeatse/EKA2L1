<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!--
        Stage-0 entitlements file. The JIT and increased-memory-limit keys are
        commented out on purpose: the dynarmic backend is not yet wired up
        (task 0.4 / stage 1), so requesting these capabilities now would only
        delay provisioning without unlocking anything. Re-enable them in
        stage 1 once the MAP_JIT path is in.
    -->
    <!--
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
    -->
</dict>
</plist>
